{
  "uid": "custom-insided-widget-gainsight",
  "app_code_name": "community_widgets",
  "display_name": {
    "en": "Community Custom Widget Gainsight"
  },
  "module": "Community",
  "permissions": [
    "community_read"
  ],
  "dimensions": {
    "min_height": 1,
    "max_height": 4,
    "height": 2,
    "min_width": 1,
    "max_width": 4,
    "width": 2
  },
  "component_data": {
    "name": "iframe",
    "config": {
      "url": "https://example.com/widget"
    }
  },
  "settings": {
    "title": {
      "type": "string",
      "label": "Widget Title",
      "default": "My Custom Widget"
    },
    "description": {
      "type": "string",
      "label": "Widget Description",
      "default": "Example custom widget for Insided"
    }
  }
}
